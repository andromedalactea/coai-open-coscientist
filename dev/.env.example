# gemini api key (for llm calls)
GEMINI_API_KEY=your_gemini_api_key_here

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# optional: dev mode for faster testing (uses reduced paper counts in literature review)
# this is separate from verbose logging - use generator.verbose=True for debug logs
COSCIENTIST_DEV_MODE=false

# mcp server endpoint (provides PubMed and other tools)
MCP_SERVER_URL=http://localhost:8888/mcp

# disable cache for dev/testing to avoid stale responses
COSCIENTIST_CACHE_ENABLED=false

# Number of retries on transient provider errors (network drops, 5xx, empty content)
# LLM_TRANSIENT_MAX_ATTEMPTS=4

# Per-request LLM timeout in seconds (default 300). OpenRouter can hang ~600s silently.
# LLM_REQUEST_TIMEOUT=300

# Heartbeat log interval while waiting on an in-flight LLM request (default 30s)
# LLM_HEARTBEAT_INTERVAL=30
