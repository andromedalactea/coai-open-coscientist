# Semantic Scholar API key (optional, increases rate limit from 1 to 10 req/sec)
SEMANTIC_SCHOLAR_API_KEY=

# Unpaywall email (required for Unpaywall API access)
UNPAYWALL_EMAIL=your_email@example.com

# LLM model for AI reranking (any litellm-compatible model)
RERANKER_MODEL=gpt-4.1-mini

# LLM provider API keys (at least one required for the reranker)
OPENAI_API_KEY=

# Server configuration
COSCIENTIST_ACADEMIC_MCP_PORT=8889
COSCIENTIST_LIT_REVIEW_DIR=./cache/literature_review
COSCIENTIST_MCP_LOG_LEVEL=INFO
