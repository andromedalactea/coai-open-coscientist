# Open Coscientist — environment template (no secrets)
#
# Copy to the project root as `.env` and fill in API keys.
# When orchestrated by Denario, these vars are typically loaded from
# `coai-denario/.env` instead (merged profile).

# ---- Credentials ----
OPENROUTER_API_KEY=your_openrouter_api_key_here
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Models (LiteLLM IDs) ----
MODEL_NAME=openrouter/deepseek/deepseek-v4-flash
LARGE_CONTEXT_MODEL=openrouter/deepseek/deepseek-v4-flash

# ---- Academic MCP (external process; default port 8889) ----
ACADEMIC_MCP_SERVER_URL=http://localhost:8889/mcp

# Optional: override where run folders are written (Denario sets this per project)
# COSCIENTIST_RUNS_DIR=/path/to/project/coscientist_runs

# ---- Fast full-feature test profile ----
# All pipeline features stay ON; counts/budgets are reduced for faster runs.
# Scale these up later for a full thesis-quality run.

COSCIENTIST_CACHE_ENABLED=true
COSCIENTIST_DEV_MODE=true

INITIAL_HYPOTHESES_COUNT=4
MAX_ITERATIONS=1
EVOLUTION_MAX_COUNT=2

ENABLE_LITERATURE_REVIEW_NODE=true
ENABLE_TOOL_CALLING_GENERATION=true

DEBATE_MAX_TURNS=3
GENERATE_LIT_TOOL_MAX_PAPERS=2

DEEPSEEK_MAX_OUTPUT_TOKENS=65536
DEEPSEEK_REASONING_EFFORT=medium

LLM_TRANSIENT_MAX_ATTEMPTS=3
LLM_REQUEST_TIMEOUT=300
LLM_HEARTBEAT_INTERVAL=30
